# Public frontend config
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Google Apps Script webhook for registration submissions
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Keep the read token server-side and set the same value in Apps Script Script Properties.
GOOGLE_SHEET_READ_TOKEN=replace_with_a_random_64_character_hex_secret

# Public photo gallery upload/review
# Keep the same random token in Apps Script Script Properties as GALLERY_UPLOAD_TOKEN.
GALLERY_UPLOAD_TOKEN=replace_with_a_random_64_character_hex_secret
# Service account used by the server-side approved-photo image proxy.
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=gallery-reader@your-project.iam.gserviceaccount.com
# Store the service account private key only in server environment variables.
GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_real_key_material\n-----END PRIVATE KEY-----\n"

# Crew login configuration for /api/crew-login
# Add the exact username you want to use for admin access.
CREW_USERNAME=crew-admin
# Store the SHA-256 hash of the password in lowercase hex format.
# Example:
# node -e "console.log(require('crypto').createHash('sha256').update('your-password').digest('hex'))"
CREW_PASSWORD_HASH=replace_with_sha256_hex_of_password
# Generate a random secret and keep it only in server-side environment variables.
CREW_SESSION_SECRET=replace_with_a_random_64_character_hex_secret
# Optional non-sensitive authentication diagnostics.
DEBUG_CREW_LOGIN=false