# Public frontend config
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Google Apps Script webhook for registration submissions
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbxSUI0lAWZylbTJdOVkHbJ40pOMKI9rH-gHdeHObGvli9V4eCy5muuJoSe_xAfLWn1-/exec

# Crew login configuration for /api/crew-login
# Add the exact username you want to use for admin access.
CREW_USERNAME=crew-admin
# Store the SHA-256 hash of the password in lowercase hex format.
# Example:
# node -e "console.log(require('crypto').createHash('sha256').update('your-password').digest('hex'))"
CREW_PASSWORD_HASH=replace_with_sha256_hex_of_password
# Optional debug logging for deployment logs. Set to false in production if you do not want raw credentials logged.
DEBUG_CREW_LOGIN=true